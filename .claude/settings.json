{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-styling.mjs\" --hook",
            "timeout": 15,
            "statusMessage": "Checking styling token rules…"
          }
        ]
      }
    ]
  }
}
